{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "ivan-anchev",
  "displayName": "Ivan Anchev's Plugins",
  "description": "bb plugins Ivan Anchev maintains.",
  "plugins": [
    {
      "id": "comfortable-type",
      "displayName": "Comfortable Type",
      "description": "A theme that sets bb's text one step larger, at 14px in the system font, with bb's own colors.",
      "icon": "AlignLeft",
      "tags": [
        "theme",
        "typography"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/comfortable-type",
          "range": "0.x",
          "tagPrefix": "comfortable-type/"
        }
      }
    },
    {
      "id": "file-tree",
      "displayName": "File Tree",
      "description": "Browse the environment's files and git changes as a tree with colored per-file-type icons.",
      "icon": "Folder",
      "tags": [
        "files",
        "git"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/file-tree",
          "range": "0.x",
          "tagPrefix": "file-tree/"
        }
      }
    },
    {
      "id": "proactive-visuals",
      "displayName": "Proactive Visuals",
      "description": "Agents answer data with an inline chart, without being asked, using bb's inline visualizations.",
      "icon": "ChartColumn",
      "tags": [
        "charts",
        "visualization",
        "agents"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/proactive-visuals",
          "range": "0.x",
          "tagPrefix": "proactive-visuals/"
        }
      }
    }
  ]
}
