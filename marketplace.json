{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "ivan-anchev",
  "displayName": "Ivan Anchev's Plugins",
  "description": "bb plugins Ivan Anchev maintains.",
  "plugins": [
    {
      "id": "boat-sandbox",
      "displayName": "boat Sandbox",
      "description": "Run bb threads on on-demand boat.dev sandboxes that stop when idle, resume on the same disk, and start from the boat saved snapshot and environment you pick, with bb's GitHub login or else boat's.",
      "icon": {
        "url": "./plugins/boat-sandbox/boat.svg"
      },
      "tags": [
        "sandbox",
        "cloud",
        "boat"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/boat-sandbox",
          "range": "0.x",
          "tagPrefix": "boat-sandbox/"
        }
      }
    },
    {
      "id": "code-explorer",
      "displayName": "Code Explorer",
      "description": "Browse the environment's files and git changes as a tree with colored per-file-type icons, see how a change splits into code, tests, mocks, generated files and docs, and read any file or its diff beside the tree.",
      "icon": "Folder",
      "tags": [
        "files",
        "git"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/code-explorer",
          "range": "0.x",
          "tagPrefix": "code-explorer/"
        }
      }
    },
    {
      "id": "comfortable-type",
      "displayName": "Comfortable Type",
      "description": "A theme that sets bb's text one step larger, at 14px in the system font, with bb's own colors.",
      "icon": "AlignLeft",
      "tags": [
        "theme",
        "typography"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/comfortable-type",
          "range": "0.x",
          "tagPrefix": "comfortable-type/"
        }
      }
    },
    {
      "id": "pr-reviews",
      "displayName": "PR Reviews",
      "description": "A PR Reviews app on the left rail that lists a GitHub project's open pull requests and opens each one as a guided review, written by a review thread, that walks you through the change step by step. Nothing is ever posted to GitHub.",
      "icon": "GitPullRequest",
      "tags": [
        "github",
        "pull-requests",
        "code-review"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/pr-reviews",
          "range": "0.x",
          "tagPrefix": "pr-reviews/"
        }
      }
    },
    {
      "id": "proactive-visuals",
      "displayName": "Proactive Visuals",
      "description": "Agents answer data with an inline chart, without being asked, using bb's inline visualizations.",
      "icon": "ChartColumn",
      "tags": [
        "charts",
        "visualization",
        "agents"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/proactive-visuals",
          "range": "0.x",
          "tagPrefix": "proactive-visuals/"
        }
      }
    },
    {
      "id": "subagents-strip",
      "displayName": "Subagents Strip",
      "description": "A live strip above the composer that counts the latest prompt's subagents and child threads, plus any still running, and how long they have taken, and opens into one row per subagent that expands to its report and latest steps and opens its full transcript in the side panel or its own thread; a Subagents tab in the side panel lists every subagent in the thread, grouped by the prompt it was launched after.",
      "icon": "UsersRound",
      "tags": [
        "subagents",
        "agents",
        "observability"
      ],
      "author": {
        "name": "Ivan Anchev",
        "github": "ivan-anchev"
      },
      "source": {
        "git": {
          "url": "https://github.com/ivan-anchev/bb-plugins.git",
          "subdir": "plugins/subagents-strip",
          "range": "0.x",
          "tagPrefix": "subagents-strip/"
        }
      }
    }
  ]
}
