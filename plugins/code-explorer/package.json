{
  "name": "bb-plugin-code-explorer",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bb-plugin",
    "files",
    "icons",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/code-explorer"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test src/chat-file-targets.test.ts",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bbMarketplace": {
    "listed": false
  },
  "bb": {
    "name": "Code Explorer",
    "description": "Puts a colored file-type icon in front of every file link and @file mention in chat, so app.tsx reads as React and README.md as Markdown at a glance.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
