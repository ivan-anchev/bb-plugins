    "branding": {
      "icon": "BellRing"
    },
    "server": "./server.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test '*.test.ts'",
    "build": "bb plugin build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
