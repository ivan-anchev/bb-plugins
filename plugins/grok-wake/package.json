    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/grok-wake"
  },
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
