{
  "name": "bb-plugin-file-tree",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bb-plugin",
    "files",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/file-tree"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test src/tree-input.test.ts",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
