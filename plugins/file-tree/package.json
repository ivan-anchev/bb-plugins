    "app": "./app.tsx"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  }
}
