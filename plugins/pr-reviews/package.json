{
  "name": "bb-plugin-pr-reviews",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bb-plugin",
    "github",
    "pull-requests",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/pr-reviews"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "PR Reviews",
    "description": "A PR Reviews app on the left rail that lists a GitHub project's open pull requests and opens each one on a page with its whole diff in a file tree and a guided review, written by a review thread, that walks you through the change step by step. It posts to GitHub only the review comments you write or pick from the guide, after a preview of exactly what and where, on your click; review threads never post to GitHub.",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/trees": "1.0.0-beta.6",
    "diff": "^9.0.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.4",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  }
}
