  "private": true,
  "license": "MIT",
  "keywords": [
    "bb-plugin",
    "sandbox",
    "cloud",
    "boat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/boat-sandbox"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.48",
