{
  "name": "bb-plugin-notes",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bb-plugin",
    "notes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-anchev/bb-plugins.git",
    "directory": "plugins/notes"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Notes",
    "description": "Experimental: it may break with a bb update. Jot a note from anywhere in bb: press ⇧⌘J or click the notes icon in the sidebar footer, type, and press ⌘↵. Your notes wait in a Notes card on the New thread screen.",
    "branding": {
      "icon": "./sticky-note.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0"
  }
}
